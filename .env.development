# Local development defaults. Copy to .env.local to override.

# true = API routes return sample data and forms are not saved.
# Set to false (and fill in the Supabase values below) to use a real database locally.
NEXT_PUBLIC_USE_MOCK_DATA="true"

# Supabase project URL (Supabase dashboard > Project Settings > API)
SUPABASE_URL=""

# Supabase secret key. Server-only: never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""

RECAPTCHA_SECRET="RECAPTCHA_SECRET"
NEXT_PUBLIC_RECAPTCHA_SITEKEY="RECAPTCHA_SITEKEY"
